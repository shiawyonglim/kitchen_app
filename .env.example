# Database (defaults to local SQLite; swap to postgresql+psycopg://... for Supabase/Postgres)
DATABASE_URL=sqlite:///./personal_erp.db

# Inbox Mode: "demo" uses built-in realistic Malaysian receipts; "imap" connects to your real mailbox
EMAIL_MODE=demo

# IMAP Settings (only needed when EMAIL_MODE=imap)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_APP_PASSWORD=


# Asset Tracker Valuation Mode: "live" uses AI Web Search (Gemini Google Search / Groq browser_search); "demo" uses simulated market data
CAROUSELL_MODE=live

# Google OAuth 2.0 + Gmail API (optional: enables "Continue with Google" & reading Google emails)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Mobile Widget (Scriptable on iPhone) & Push Notifications (ntfy.sh)
WIDGET_API_TOKEN=
WIDGET_USER_ID=1
NTFY_TOPIC_URL=

# Personal Assistant AI & Asset Web Search
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=

# Local WhatsApp Web Bridge (Option 1) shared secret for /api/assistant/whatsapp-ingest
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_BRIDGE_USER_ID=1


